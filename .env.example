# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection String (If left empty or unavailable, in-memory MongoDB will be used automatically for demo)
MONGODB_URI=mongodb://127.0.0.1:27017/community_college_erp

# JWT Authentication Config
JWT_SECRET=community_college_erp_super_secret_jwt_key_2026_xyz
JWT_EXPIRE=30d

# CORS Allowed Origin
CORS_ORIGIN=*
